# Root workspace .gitignore
# Sub-project build artifacts are managed by each sub-project's own .gitignore
# Do not add source-code-related ignores here

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
*.swo

# Env files — never committed at any level
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Agent working directory and browser-automation scratch output. Neither is project
# content: .workspace/ is per-developer scratch by rule, and .playwright-mcp/ is a tool's
# transcript of a test run.
.workspace/
.playwright-mcp/

# Brainstorming visual companion sessions
.superpowers/

# Written at container startup by the official ClickHouse entrypoint into the bind-mounted
# users.d directory (disables the "default" user in favour of CLICKHOUSE_USER); contains that
# user's password in plaintext and must never be committed.
observability/clickhouse/users.d/default-user.xml
